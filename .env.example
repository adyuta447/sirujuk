# Copy to .env (git-ignored) and fill with generated values. Never commit real secrets.
APP_ENV=production
# openssl rand -hex 32
API_TOKEN=
# openssl rand -hex 24
REDIS_PASSWORD=
# Session signing key (>= 32 random chars): openssl rand -hex 32. Compose requires it.
AUTH_SECRET=
# Local login accounts (JSON array from frontend/scripts/buat-pengguna.mjs).
# Empty ([]) = no local login; production uses Firestore instead.
AUTH_USERS=[]
# Fill the in-memory list with N fake referrals for a local demo (0 = empty).
SEED_COUNT=0
# true only for demo: trusts doctor history sent by the client
ALLOW_CLIENT_CONTEXT=false
# p80 / p95 of the current model's score distribution
YELLOW_FROM=7.8
RED_FROM=45
