# Copy to .env (git-ignored) and fill with generated values. Never commit real secrets.
APP_ENV=production
# openssl rand -hex 32
API_TOKEN=
# openssl rand -hex 24
REDIS_PASSWORD=
# true only for demo: trusts doctor history sent by the client
ALLOW_CLIENT_CONTEXT=false
# The yellow/red cut-offs (p80/p95) come from the ML model itself; the backend keeps none.
# The 144 non-specialist (KNS) list comes from ml-service/app/ml/data/kns144.tsv (secondary source, needs clinical review).
# For a non-compose run set KNS_FILE to that path; without it NS(d) stays off. Compose mounts it automatically.
# Required in production: Firestore project for accounts, referrals, audits and clarifications.
FIRESTORE_PROJECT=
# openssl rand -hex 32 : signs the login session cookie (frontend, 32+ characters). Login is refused without it; compose requires it.
AUTH_SECRET=
# Local demo only: APP_ENV=development, DEMO_ACCOUNTS=true, SEED_COUNT=200, ALLOW_CLIENT_CONTEXT=true. Never in production.
DEMO_ACCOUNTS=false
# Fill the in-memory list with N synthetic referrals for a local demo (0 = empty). Refused in production.
SEED_COUNT=0
# Custom local accounts (JSON array from frontend/scripts/buat-pengguna.mjs). Empty ([]) = none.
AUTH_USERS=[]
# openssl rand -hex 32 : encrypts referrals queued in Redis (patient data). Required; the backend refuses to start without it in production.
STREAM_ENC_KEY=
# Optional policy: hold a claim (red) only when this many independent layers contribute. 1 = trust the model; 2 recommended.
MIN_RED_LAYERS=1
