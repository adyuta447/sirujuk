# Disalin ke .env.local (pengembangan) atau variabel lingkungan server. Jangan commit nilai asli.
# Alamat backend Go dan token layanan: hanya dibaca server, jangan pakai awalan NEXT_PUBLIC_.
BACKEND_URL=https://sirujuk-backend-148917316834.us-east4.run.app
API_TOKEN=

# Penanda tangan sesi. Wajib >= 32 karakter acak: openssl rand -hex 32
AUTH_SECRET=

# Akun login tidak ada di sini: disimpan di Firestore milik backend. Tambah akun dengan
#   cd backend-go && SANDI='min-12-karakter' go run ./cmd/useradd -project <id-project> -email a@b.id -nama "Nama" -role verifikator

# Akun demo di halaman login (masuk satu klik per peran, tanpa kata sandi). Default mati.
# Aktifkan hanya untuk demo/hackathon, dan matikan saat ada data asli: DEMO_MODE=true
# Diabaikan bila APP_ENV=production. Vercel Production ikut membaca ini (sirujuk.vercel.app dipakai untuk demo hackathon).
DEMO_MODE=
